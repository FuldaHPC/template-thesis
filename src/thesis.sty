% ---------------------------------------------------------------------------
% Configuration
% ---------------------------------------------------------------------------
% thesis-config.tex is read before this package.
% The defaults below keep an older configuration file working after an update.

\providecommand{\ThesisLanguage}{english}
\providecommand{\ThesisDraft}{false}
\providecommand{\ThesisProgram}{}
\providecommand{\ThesisKeywords}{}

\newtoggle{thesisbachelor}
\ifdefstring{\ThesisType}{bachelor}
  {\toggletrue{thesisbachelor}}
  {\ifdefstring{\ThesisType}{master}
    {\togglefalse{thesisbachelor}}
