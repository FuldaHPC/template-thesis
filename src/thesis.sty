% ---------------------------------------------------------------------------
% Colors
% ---------------------------------------------------------------------------
% Defined ahead of draft mode, which colors its watermark with hpcgreen.

\definecolor{hpcgreen}{HTML}{68B900}
\definecolor{hpcblue}{HTML}{247DB3}
\definecolor{hpcblack}{HTML}{17191B}
\definecolor{hpcgray}{HTML}{6F7478}

% Link text stays black; a thin colored border drawn by the PDF viewer marks what is clickable instead.
% The border is part of the link annotation, not the page, so it never appears in print.
% hyperref is loaded before these colors exist, so they are assigned here rather than as package options.
\hypersetup{
  pdfborder={0 0 1},
  linkbordercolor=hpcblue,
  citebordercolor=hpcblue,
  urlbordercolor=hpcgreen
}

% Suppresses the link border boxes for the rest of the current group.
% The table of contents and the lists use this: their entries are obviously clickable, so the boxes would be pure noise there, while body links keep their markers.
\newcommand{\ThesisBorderlessLinks}{\hypersetup{pdfborder={0 0 0}}}

% ---------------------------------------------------------------------------
% Draft mode
% ---------------------------------------------------------------------------
% A draft build is for circulation and feedback, never for submission.
% Line numbers in particular make it far easier to point at a specific sentence.
\iftoggle{thesisdraft}{%
  \RequirePackage[textwidth=2.4cm,textsize=footnotesize]{todonotes}
  \RequirePackage{eso-pic}
  \RequirePackage{lineno}
  \newcommand{\thesis@draftmark}{%
    \rotatebox{90}{%
      \sffamily\bfseries\fontsize{13}{13}\selectfont
      \color{hpcgreen}\ThesisText{DRAFT}{ENTWURF}%
    }%
  }
  \AddToShipoutPictureBG{%
    \AtPageLowerLeft{%
      \put(\LenToUnit{13mm},\LenToUnit{.5\paperheight}){\makebox(0,0){\thesis@draftmark}}%
      \put(\LenToUnit{\dimexpr\paperwidth-13mm\relax},\LenToUnit{.5\paperheight}){\makebox(0,0){\thesis@draftmark}}%
    }%
  }
  \newcommand{\thesis@linenopatch}[1]{%
    \expandafter\let\csname thesis@old#1\expandafter\endcsname\csname #1\endcsname
    \expandafter\let\csname thesis@oldend#1\expandafter\endcsname\csname end#1\endcsname
    \renewenvironment{#1}%
      {\linenomath\csname thesis@old#1\endcsname}%
      {\csname thesis@oldend#1\endcsname\endlinenomath}%
  }
  \AtBeginDocument{%
    \thesis@linenopatch{equation}%
    \thesis@linenopatch{align}%
    \thesis@linenopatch{gather}%
    \thesis@linenopatch{multline}%
    \linenumbers
  }%
}{%
  % \todo{...} stays valid but produces nothing in a normal build.
  \RequirePackage[disable]{todonotes}
}

