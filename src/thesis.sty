      {Unknown ThesisType '\ThesisType'}
      {Use 'bachelor' or 'master' in thesis-config.tex.}}}

\newtoggle{thesisgerman}
\ifdefstring{\ThesisLanguage}{german}
  {\toggletrue{thesisgerman}}
  {\ifdefstring{\ThesisLanguage}{english}
    {\togglefalse{thesisgerman}}
    {\PackageError{thesis}
      {Unknown ThesisLanguage '\ThesisLanguage'}
      {Use 'english' or 'german' in thesis-config.tex.}}}

% "make draft" passes \def\ThesisDraftOverride{} ahead of the document.
\newtoggle{thesisdraft}
\ifdef{\ThesisDraftOverride}
  {\toggletrue{thesisdraft}}
  {\ifdefstring{\ThesisDraft}{true}
    {\toggletrue{thesisdraft}}
    {\ifdefstring{\ThesisDraft}{false}
      {\togglefalse{thesisdraft}}
      {\PackageError{thesis}
        {Unknown ThesisDraft '\ThesisDraft'}
        {Use 'true' or 'false' in thesis-config.tex.}}}}

