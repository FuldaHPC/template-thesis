% ---------------------------------------------------------------------------
% Listings, algorithms, acronyms
% ---------------------------------------------------------------------------

% listings styles preprocessor directives (#pragma, #include) as their own keyword class and leaves them plain unless directivestyle is set.
% The directivestyle key itself only exists once the directives aspect is loaded, which normally happens with the first language that uses it — after this \lstset has already failed.
\lstloadaspects{directives}
% Upstream, a directive is only recognized when its # sits in column 0 (the \ifnum\@tempcnta=\z@ test on \lst@CalcColumn), so an indented #pragma would stay unstyled.
% The redefinition below is \lst@Delim@directive from lstmisc.sty verbatim, except that the column test is relaxed to accept any column.
% A # inside a string or comment is still safe, because those modes take precedence over delimiter matching.
\gdef\lst@Delim@directive#1\@empty#2#3#4{%
    \lst@CArg #1\relax\lst@DefDelimB
        {\lst@CalcColumn}%
        {}%
        {\ifnum\@tempcnta>\m@ne
             \def\lst@bnext{#2\lst@CDmode{#4\lst@Lmodetrue}%
                \let\lst@currstyle\lst@directivestyle}%
 \fi
 \@gobblethree}%
        #2\lst@CDmode{#4\lst@Lmodetrue}}
\lstset{
  basicstyle=\ttfamily\small,
  keywordstyle=\bfseries\color{hpcblue},
  directivestyle={\bfseries\color{hpcblue}},
  commentstyle=\itshape\color{hpcgray},
  stringstyle=\color{hpcgreen!65!black},
  numbers=left,
  numberstyle=\scriptsize\color{hpcgray},
  numbersep=8pt,
  xleftmargin=1.8em,
  framexleftmargin=1.2em,
  frame=leftline,
  rulecolor=\color{hpcgreen},
  breaklines=true,
  columns=fullflexible,
  keepspaces=true,
  showstringspaces=false,
  tabsize=2,
  captionpos=b
}
\renewcommand{\lstlistingname}{\ThesisStrListing}
\renewcommand{\lstlistlistingname}{\ThesisStrListOfListings}

\SetAlgorithmName{\ThesisStrAlgorithm}{\ThesisStrAlgorithm}{\ThesisStrListOfAlgorithms}

% algorithm2e's language option translates the float name but leaves \KwIn and \KwOut in English, so they are set here.
% The option is "german" rather than "ngerman" because the latter puts a space before the colon, which is French typography, not German.
% The control-flow keywords (for, while, return) stay English on purpose: that is the norm in German computer science writing, and half-translated pseudocode reads worse than consistently English.
\IfGermanTF{%
  \SetKwInput{KwIn}{Eingabe}%
  \SetKwInput{KwOut}{Ausgabe}%
  \SetKwInput{KwData}{Daten}%
  \SetKwInput{KwResult}{Ergebnis}%
}{}

\acsetup{make-links=true}

% cleveref knows the standard float types, but not these two.
\AtBeginDocument{%
  \IfGermanTF{%
    \crefname{algocf}{Algorithmus}{Algorithmen}%
    \Crefname{algocf}{Algorithmus}{Algorithmen}%
    \crefname{lstlisting}{Quelltext}{Quelltexte}%
    \Crefname{lstlisting}{Quelltext}{Quelltexte}%
  }{%
    \crefname{algocf}{Algorithm}{Algorithms}%
    \Crefname{algocf}{Algorithm}{Algorithms}%
    \crefname{lstlisting}{Listing}{Listings}%
    \Crefname{lstlisting}{Listing}{Listings}%
  }%
}

% ---------------------------------------------------------------------------
% Empty lists are skipped
% ---------------------------------------------------------------------------
% A thesis without listings should not carry an empty List of Listings.
% Every \addcontentsline records which list it fed, the flags are written to the
% .aux file, and the next run reads them back before the front matter is typeset.
% A list therefore appears from the second build onwards, which latexmk does anyway.

\newtoggle{thesis@listhook}
\toggletrue{thesis@listhook}

\newcommand{\thesis@marklist}[1]{\expandafter\gdef\csname thesis@now@#1\endcsname{}}
\newcommand{\ThesisListSeen}[1]{\expandafter\gdef\csname thesis@seen@#1\endcsname{}}

\newcommand{\thesis@writelistflag}[1]{%
  \@ifundefined{thesis@now@#1}{}{%
    \immediate\write\@auxout{\string\ThesisListSeen{#1}}%
  }%
}

\pretocmd{\addcontentsline}{\thesis@marklist{#1}}{}{\togglefalse{thesis@listhook}}

% If the hook could not be installed, print every list rather than silently dropping one.
\newcommand{\ThesisIfListSeen}[2]{%
  \iftoggle{thesis@listhook}
    {\@ifundefined{thesis@seen@#1}{}{#2}}
    {#2}%
}

% acro does not feed \addcontentsline, so acronym use is recorded separately.
% If a command cannot be patched, the flag is set right away, so the list is
% printed rather than silently dropped.
\newcommand{\thesis@markacronym}[1]{%
  \pretocmd{#1}{\thesis@marklist{acr}}{}{\thesis@marklist{acr}}%
}
\thesis@markacronym{\ac}
\thesis@markacronym{\acs}
\thesis@markacronym{\acl}
\thesis@markacronym{\acp}

\AtEndDocument{%
  \thesis@writelistflag{lof}%
  \thesis@writelistflag{lot}%
  \thesis@writelistflag{lol}%
  \thesis@writelistflag{loa}%
  \thesis@writelistflag{acr}%
}

% ---------------------------------------------------------------------------
% Chapter opener
% ---------------------------------------------------------------------------

% Track appendix mode so the chapter badge shows A, B, ... instead of 01, 02.
\newif\ifthesisappendix
\pretocmd{\appendix}{\global\thesisappendixtrue}{}{}

\newcommand{\ChapterBadgeNumber}{%
  \ifthesisappendix
    \thechapter
  \else
    \ifnum\value{chapter}<10 0\fi\arabic{chapter}%
  \fi
}

% Restrained chapter opener.
% Text starts on the following page.
\newcommand{\ThesisChapter}[3]{%
  \cleardoublepage
  \refstepcounter{chapter}%
  \phantomsection
  \addcontentsline{toc}{chapter}{\protect\numberline{\thechapter}#1}%
  \label{#2}%
  \markboth{\thechapter\enskip #1}{\thechapter\enskip #1}%
  \thispagestyle{empty}%

  \vspace*{14mm}
  \noindent
  \begin{minipage}[t][.69\textheight][t]{\textwidth}
    {\sffamily\bfseries\footnotesize\color{hpcgray}
      \ThesisStrChapter\ \ChapterBadgeNumber\par}

    \vspace{4mm}
    \noindent
    {\color{hpcgreen}\rule{.72\textwidth}{1.1pt}}%
    {\color{hpcblue}\rule{.28\textwidth}{1.1pt}}

    \vspace{29mm}

    \noindent
    {\fontsize{41}{41}\selectfont\bfseries\color{hpcgreen}
      \ChapterBadgeNumber\par}

    \vspace{8mm}

    \noindent
    {\raggedright\fontsize{27}{32}\selectfont
      \bfseries\color{hpcblack}#1\par}

    \vspace{22mm}

    {\sffamily\bfseries\footnotesize\color{hpcblue}
      \ThesisStrChapterOverview\par}
    \vspace{5mm}
    \noindent
    \begin{minipage}[t]{4mm}
      \vspace{0pt}
      {\color{hpcgreen}\rule{2.2pt}{4.7\baselineskip}}
    \end{minipage}
    \hspace{3mm}
    \begin{minipage}[t]{\dimexpr\linewidth-9mm\relax}
      \vspace{0pt}
      {\large\itshape\color{hpcblack}#3\par}
    \end{minipage}

    \vfill

    \noindent{\color{hpcblack!20}\rule{\textwidth}{.5pt}}\par
  \end{minipage}
  \clearpage
}

\newcommand{\SignatureLine}[1]{%
  \begin{minipage}[t]{.44\textwidth}
    \vspace{1.2cm}
    \hrule
    \vspace{.35em}
    \small #1
  \end{minipage}
}
